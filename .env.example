# Service LLM central (LLM-Service, géré à part : ce dépôt ne le démarre ni ne l'arrête).
# Copier en .env (ignoré par git) et renseigner la clé : valeur de LITELLM_MASTER_KEY dans le .env de LLM-Service.
# Adresse depuis un conteneur du réseau llm-net (RAGFlow) :
LLM_CENTRAL_URL=http://llm-central:8080/v1
# Adresse depuis l'hôte (scripts, essais) :
LLM_CENTRAL_URL_HOTE=http://127.0.0.1:8080/v1
# Clé obligatoire (jamais commitée) : sk-local-…
LLM_CENTRAL_KEY=
# Noms de modèles fixes du service (alias LiteLLM)
LLM_CENTRAL_CHAT=chat
LLM_CENTRAL_EMBED=embed
LLM_CENTRAL_RERANK=rerank
LLM_CENTRAL_TRANSCRIBE=transcribe
